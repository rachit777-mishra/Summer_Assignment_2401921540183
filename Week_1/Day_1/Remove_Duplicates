class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        set<int> s(nums.begin(),nums.end());
        
        vector<int>result;

        for(int x : s)
        {
            result.push_back(x);
        }
        for(int i = 0; i < result.size(); i++) {
            nums[i] = result[i];
        }
        return result.size();
        
    }
};
